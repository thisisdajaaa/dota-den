# Copy to .env.local and fill in. Never commit real values.
# Every variable is documented in docs/configuration.md.

# --- Core ------------------------------------------------------------------
APP_URL=http://localhost:3000

# MongoDB connection string (least-privilege database user).
MONGODB_URI=
MONGODB_DB_NAME=dota_den_dev
MONGODB_MAX_POOL_SIZE=10

LOG_LEVEL=info

# --- Upstream keys (server-only, optional) -----------------------------------
# OpenDota: raises the shared free limit (about 60 requests a minute).
OPENDOTA_API_KEY=
# Steam Web API: enables custom-URL (steamcommunity.com/id/...) lookups.
STEAM_WEB_API_KEY=

# Comma-separated SteamID64s granted the admin role (patch ingestion).
ADMIN_STEAM_IDS=

# Bearer secret Vercel Cron sends to /api/cron/* (at least 16 chars). Unset disables cron routes.
CRON_SECRET=

# E2E only: replaces Steam OpenID with a fake provider. Refused when NODE_ENV=production.
AUTH_TEST_MODE=false

# --- AI (Groq, OpenAI-compatible) -----------------------------------------
# Optional: without a key the AI captain uses its data-only fallback and the AI review is off.
GROQ_API_KEY=
DRAFT_AI_MODEL=openai/gpt-oss-120b
DRAFT_AI_MOVE_TIMEOUT_MS=15000
DRAFT_AI_REVIEW_TIMEOUT_MS=30000
DRAFT_AI_REVIEW_ENABLED=true

# --- Operator tuning (optional; defaults shown) -------------------------------
# Rate limits per client, per minute unless noted.
RATE_LIMIT_DRAFT_AI_MOVE_PER_MIN=40
RATE_LIMIT_DRAFT_SUGGESTIONS_PER_MIN=60
RATE_LIMIT_DRAFT_OUTLOOK_PER_MIN=60
RATE_LIMIT_DRAFT_REVIEW_PER_MIN=6
RATE_LIMIT_DRAFT_CHALLENGE_PER_MIN=30
RATE_LIMIT_ROOM_CREATE_PER_HOUR=10
RATE_LIMIT_ROOM_POLL_PER_MIN=240
RATE_LIMIT_ROOM_ACTION_PER_MIN=120

# Multiplayer draft rooms.
DRAFT_ROOMS_MAX_ACTIVE=50
DRAFT_ROOMS_ACTIVE_WINDOW_MINUTES=120
DRAFT_ROOM_TTL_HOURS=24

# Tournament data for the draft AI (OpenDota explorer).
DRAFT_PRO_WINDOW_DAYS=21
DRAFT_SYNERGY_WINDOW_DAYS=60
DRAFT_META_FRESH_HOURS=12
DRAFT_EXPLORER_BUDGET_MS=4000

# OpenDota requests.
OPENDOTA_TIMEOUT_MS=8000
OPENDOTA_MAX_RETRIES=2
OPENDOTA_EXPLORER_TIMEOUT_MS=30000
OPENDOTA_EXPLORER_MAX_RETRIES=1

# Leaderboards.
LEADERBOARD_ROW_LIMIT=50
LEADERBOARD_EVERYONE_MAX_PLAYERS=5000

# Sessions: the break that splits two sessions for users who haven't chosen one (30, 60, 90 or 120).
SESSION_DEFAULT_GAP_MINUTES=60

# ---- Redis and background jobs (Upstash, ADR 0008). All optional. ----
# Leave empty for local dev, CI and E2E: the app then uses per-instance rate limits and
# caches and runs background jobs in-process after the response.
# Upstash Redis (REST): shared rate limits, shared OpenDota cache and the global call budget.
# URL: https://<your-db-host>. Token: the REST token, or the database password (they work alike).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Upstash QStash: durable background jobs delivered to ${APP_URL}/api/jobs/<name>.
# QSTASH_TOKEN needs QSTASH_CURRENT_SIGNING_KEY (and QSTASH_NEXT_SIGNING_KEY for key rotation).
QSTASH_TOKEN=
# Optional: QStash API base URL (regional endpoint or `npx @upstash/qstash-cli dev`).
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Global OpenDota call budget across all instances (needs Redis). Defaults: 60/min and
# 3000/day, or 1200/min and 100000/day when OPENDOTA_API_KEY is set.
OPENDOTA_BUDGET_PER_MINUTE=
OPENDOTA_BUDGET_PER_DAY=
# ---- end Redis and background jobs ----
