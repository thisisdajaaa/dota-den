# Copy to .env.local and fill in. Never commit real values.
APP_URL=http://localhost:3000

# MongoDB Atlas connection string (least-privilege database user).
MONGODB_URI=
MONGODB_DB_NAME=dota_den_dev
MONGODB_MAX_POOL_SIZE=10

LOG_LEVEL=info

# Optional upstream keys (server-only).
OPENDOTA_API_KEY=
STEAM_WEB_API_KEY=

# Comma-separated SteamID64s granted the admin role (patch ingestion).
ADMIN_STEAM_IDS=

# Bearer secret Vercel Cron sends to /api/cron/* (at least 16 chars). Unset disables cron routes.
CRON_SECRET=

# E2E only: replaces Steam OpenID with a fake provider. Refused when NODE_ENV=production.
AUTH_TEST_MODE=false

# AI draft opponent (Groq, OpenAI-compatible). Optional: without a key the AI uses a rule-based fallback.
GROQ_API_KEY=
DRAFT_AI_MODEL=openai/gpt-oss-120b

# ---- Redis and background jobs (Upstash, ADR 0008). All optional. ----
# Leave empty for local dev, CI and E2E: the app then uses per-instance rate limits and
# caches and runs background jobs in-process after the response.
# Upstash Redis (REST): shared rate limits, shared OpenDota cache and the global call budget.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Upstash QStash: durable background jobs delivered to ${APP_URL}/api/jobs/<name>.
# QSTASH_TOKEN needs QSTASH_CURRENT_SIGNING_KEY (and QSTASH_NEXT_SIGNING_KEY for key rotation).
QSTASH_TOKEN=
# Optional: QStash API base URL (regional endpoint or `npx @upstash/qstash-cli dev`).
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Global OpenDota call budget across all instances (needs Redis). Defaults: 60/min and
# 3000/day, or 1200/min and 100000/day when OPENDOTA_API_KEY is set.
OPENDOTA_BUDGET_PER_MINUTE=
OPENDOTA_BUDGET_PER_DAY=
# ---- end Redis and background jobs ----
